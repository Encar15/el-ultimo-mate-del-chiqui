import wollok.game.*
import detectives.*
import objetos.*
import interacciones.*
import restoPersonajes.*
import directorJuego.*
import dialogos.*
import controles.*
import debug.*
import instancias.*


program juego {
    game.title("El Ultimo Mate del Chiqui Tapia")
    game.cellSize(100)
    game.width(23)
    game.height(12)

    nivel.iniciarPartida()

    controles.configurar()
    debug.configurar()

    game.start()
}