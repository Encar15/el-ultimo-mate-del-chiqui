import wollok.game.*
import detectives.*
import objetos.*
import interacciones.*
import restoPersonajes.*
import directorJuego.*

program juego {
    game.title("El Ultimo Mate del Chiqui Tapia")
    game.cellSize(50)
    game.width(16)
    game.height(12)
    //los fondos deben medir exactamente 800x600

    nivel.configurarInicio()

    keyboard.right().onPressDo({ detective.siguiente() })
    keyboard.left().onPressDo({ detective.anterior() })
    keyboard.enter().onPressDo({ detective.confirmar() })
    keyboard.z().onPressDo({ interacciones.interactuar() })

    game.start()
}