import wollok.game.*
import example.*


program juego {
    game.title("juego")
    game.height(10)
    game.width(10)

    game.addVisual(textoSeleccion)

    keyboard.right().onPressDo { detective.siguiente() }
    keyboard.left().onPressDo { detective.anterior() }
    keyboard.enter().onPressDo { detective.confirmar() }
    game.start()
}
